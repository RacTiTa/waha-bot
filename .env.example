# --- Servidor del bot ---
PORT=3001

# --- WAHA (WhatsApp HTTP API) ---
WAHA_URL=http://localhost:3000
WAHA_SESSION=default
# Debe coincidir con WHATSAPP_API_KEY del docker-compose.yml
WAHA_API_KEY=cambiame-por-una-clave-larga
# Clave con la que WAHA firma cada webhook (header X-Webhook-Hmac). Vacia = sin validar.
WEBHOOK_HMAC_KEY=cambiame-tambien

# --- Comportamiento ---
# Lista separada por comas de numeros habilitados (sin +, formato 5491122334455).
# Vacio = responde a cualquier chat privado.
ALLOWED_NUMBERS=
# Responder tambien en grupos (true/false)
REPLY_IN_GROUPS=false
TIMEZONE=America/Argentina/Buenos_Aires

# --- API de futbol ---
# auto = usa api-football si hay APIFOOTBALL_KEY, si no Promiedos.
# Valores: auto | api-football | promiedos | thesportsdb
FOOTBALL_PROVIDER=auto

# Promiedos: sin key, pero es scraping del HTML del sitio (puede romperse).
# El id sale de la URL del equipo: /team/boca-juniors/igg -> igg
PROMIEDOS_TEAM_ID=igg

# API-Football (https://dashboard.api-football.com) - recomendado para fixtures futuros
APIFOOTBALL_KEY=
APIFOOTBALL_TEAM_ID=451

# TheSportsDB: "3" es la key publica de prueba. Sirve para resultados pasados,
# pero NO devuelve partidos futuros; para eso hace falta una key premium.
SPORTSDB_KEY=3
SPORTSDB_TEAM_ID=135156

FOOTBALL_CACHE_MINUTES=10

# --- Avisos automaticos ---
# A quien avisarle. Vacio = apagado. Separar con comas.
# Numero (5491122334455) o id de grupo (1234567890-1234567890@g.us).
NOTIFY_TO=
# Hora local del aviso "hoy juega" (HH:MM)
NOTIFY_MATCH_DAY_AT=09:00
# Cuantos minutos antes del partido empieza a buscar la formacion
NOTIFY_LINEUP_MINUTES=60
# Cada cuanto revisa (minutos)
NOTIFY_POLL_MINUTES=5
# Donde recuerda que ya aviso (para no repetir al reiniciar)
NOTIFY_STATE_FILE=.state/notifications.json

# --- Dashboard de WAHA (http://localhost:3000/dashboard) ---
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=admin

# Swagger docs (http://localhost:3000/). WHATSAPP_SWAGGER_USERNAME tiene que ser
# igual a WAHA_API_KEY: es el workaround de un bug del dashboard que manda este
# usuario como si fuera la x-api-key (https://github.com/devlikeapro/waha/issues/2269).
WHATSAPP_SWAGGER_USERNAME=cambiame-por-una-clave-larga
WHATSAPP_SWAGGER_PASSWORD=cambiame-tambien
