{
  "name": "waha-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bot de WhatsApp sobre WAHA que responde consultas conectandose a APIs externas",
  "main": "src/index.ts",
  "scripts": {
    "test": "tsx --test test/*.test.ts",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "typecheck": "tsc",
    "waha:up": "docker compose up -d",
    "waha:down": "docker compose down",
    "waha:logs": "docker compose logs -f waha"
  },
  "engines": {
    "node": ">=20.6.0"
  },
  "dependencies": {
    "express": "^4.21.2",
    "tsx": "^4.23.13"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^20.19.43",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
